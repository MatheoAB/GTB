<?php
// api.php

// Sécurité : charger les variables d'environnement depuis un fichier .env
require_once __DIR__ . '/vendor/autoload.php';
$dotenv = Dotenv\Dotenv::createImmutable(__DIR__);
$dotenv->safeLoad();

// Paramètres de connexion à la base MySQL
$DB_HOST = $_ENV['DB_HOST'] ?? '127.0.0.1';
$DB_NAME = $_ENV['DB_NAME'] ?? '';
$DB_USER = $_ENV['DB_USER'] ?? '';
$DB_PASS = $_ENV['DB_PASSWORD'] ?? '';
$DB_PORT = $_ENV['DB_PORT'] ?? '3306';

// Connexion sécurisée PDO
try {
    $pdo = new PDO(
        "mysql:host=$DB_HOST;dbname=$DB_NAME;port=$DB_PORT;charset=utf8mb4",
        $DB_USER,
        $DB_PASS,
        [PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION]
    );
} catch (Exception $e) {
    http_response_code(500);
    echo json_encode(['error' => 'Database connection error']);
    exit;
}

// Headers pour l’API
header('Content-Type: application/json');

// Récupère la route de l’URL
$request = $_SERVER['REQUEST_URI'];
$script = dirname($_SERVER['SCRIPT_NAME']);
$path = str_replace($script, '', $request);
$parts = array_values(array_filter(explode('/', $path)));

// Ex : /api.php/table ou /api.php/table/12
if (count($parts) < 1 || $parts[0] === 'api.php') {
    http_response_code(404);
    echo json_encode(['error' => 'No resource specified']);
    exit;
}

$table = preg_replace('/[^a-zA-Z0-9_]/', '', $parts[0]); // Nom de table safe

if (isset($parts[1]) && is_numeric($parts[1])) {
    // Lecture d’une ligne par ID
    $id = intval($parts[1]);
    // On suppose que la clé primaire est "id"
    try {
        $stmt = $pdo->prepare("SELECT * FROM `$table` WHERE id = :id LIMIT 1");
        $stmt->execute(['id' => $id]);
        $row = $stmt->fetch(PDO::FETCH_ASSOC);
        if ($row) {
            echo json_encode($row);
        } else {
            http_response_code(404);
            echo json_encode(['error' => 'Not found']);
        }
    } catch (Exception $e) {
        http_response_code(500);
        echo json_encode(['error' => 'Query error']);
    }
} else {
    // Lecture de la table complète (max 100 lignes)
    try {
        $stmt = $pdo->query("SELECT * FROM `$table` LIMIT 100");
        $rows = $stmt->fetchAll(PDO::FETCH_ASSOC);
        echo json_encode($rows);
    } catch (Exception $e) {
        http_response_code(500);
        echo json_encode(['error' => 'Query error']);
    }
}